@page "/"
@attribute [AllowAnonymous]

<PageTitle>Contoso Operations Portal</PageTitle>

<section class="ci-hero ci-admin-hero">
    <div class="ci-hero-copy">
        <p class="ci-kicker">Internal operations</p>
        <h2>Manage claims, underwriting, and queue health from one workspace.</h2>
        <p class="ci-muted">This authenticated Blazor portal is for Contoso Insurance operations staff only.</p>
        <div class="ci-button-row">
            <a class="btn-ci btn-primary-ci" href="/portal">Open portal</a>
            <a class="btn-ci btn-secondary-ci" href="/auth/signin">Sign in with Entra ID</a>
        </div>
    </div>
</section>
